{
  "name": "repomit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node scripts/start.mjs",
    "db:init": "node --experimental-strip-types scripts/init-db.ts",
    "db:backup": "node --experimental-strip-types scripts/backup-db.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:production": "node --experimental-strip-types tests/production-smoke.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.0.0",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/yauzl": "^3.4.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.0.0",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "entities": "^8.1.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "pg": "^8.23.0",
    "sanitize-html": "^2.17.7",
    "saxes": "^6.0.0",
    "yauzl": "^3.4.0"
  },
  "overrides": {
    "cookie": "^0.7.2",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
