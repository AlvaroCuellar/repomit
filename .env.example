# Base de datos local (opcional, ruta absoluta recomendada en servidor).
# REPOMIT_DB=/ruta/persistente/repomit.sqlite
# En Vercel se configura automáticamente al conectar PostgreSQL.
# DATABASE_URL=postgresql://usuario:contraseña@servidor/base?sslmode=require
# ORIGIN=https://tu-dominio.example
# BODY_SIZE_LIMIT=6M (npm start ya aplica este límite para importar Excel)
