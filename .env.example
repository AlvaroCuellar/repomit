# Base de datos local (opcional, ruta absoluta recomendada en servidor).
# REPOMIT_DB=/ruta/persistente/repomit.sqlite
# Producción: instantánea SQLite en Vercel Blob privado, sin dependencia de Neon.
# REPOMIT_STORAGE=vercel-blob
# BLOB_READ_WRITE_TOKEN lo proporciona Vercel; nunca se publica ni añade a Git.
# REPOMIT_READ_ONLY=1 pausa escrituras durante una migración (0 en uso normal).
# DATABASE_URL solo se conserva como adaptador de migración/recuperación legado.
# ORIGIN=https://tu-dominio.example
# BODY_SIZE_LIMIT=6M (npm start ya aplica este límite para importar Excel)
